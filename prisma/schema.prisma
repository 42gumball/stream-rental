// Prisma schema for the Stream Rentals manager.
//
// Uses PostgreSQL (Neon). The connection string lives in DATABASE_URL
// (local: .env — gitignored; production: set it in the Vercel dashboard).
//
// Streaming platforms are generalized: a single `Account` (a plan you pay for)
// owns many `Slot`s (the shares you rent out). The `platform` field selects
// per-platform behavior/terminology from lib/platforms.ts — so Spotify uses
// "members", Netflix uses "profiles", and new platforms are just a code entry.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A person you rent a service to.
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String? // used for SMS reminders (international format, e.g. +2449...)
  email     String? // used for email reminders
  notes     String?
  createdAt DateTime @default(now())

  slots     Slot[]
  payments  Payment[]
  reminders ReminderLog[]
}

/// A streaming-platform account YOU pay for and rent shareable slots from.
/// `platform` ("spotify" | "netflix" | "hulu" | …) drives behavior in code.
model Account {
  id            String    @id @default(cuid())
  platform      String
  label         String // e.g. "Family 1", "Netflix 1"
  ownerName     String? // plan admin/owner where relevant (Spotify admin, Apple organizer)
  planName      String? // plan tier where relevant (Netflix "Premium")
  loginEmail    String? // the account login (for your reference)
  loginPassword String? // optional, stored for your reference only
  monthlyCost   Int       @default(0) // what YOU pay the platform per cycle (Kz)
  maxSlots      Int       @default(6) // how many people this plan fits
  dueDate       DateTime? // when YOUR next payment to the platform is due
  paidThrough   DateTime? // you have paid the platform up to this date
  createdAt     DateTime  @default(now())

  slots    Slot[]
  expenses Expense[]

  @@index([platform])
}

/// One shareable slot in an Account, rented to a customer (a Spotify member, a
/// Netflix profile, …). May be left unassigned for platforms that allow it.
model Slot {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name        String? // profile name / username / slot label
  price       Int       @default(0) // Kz per cycle the customer pays you
  paidThrough DateTime? // this customer has paid you up to this date
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  payments Payment[]
}

/// Money coming IN — a customer paid you. Drives the revenue report.
model Payment {
  id         String    @id @default(cuid())
  platform   String // "spotify" | "netflix" | …
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  slotId     String?
  slot       Slot?     @relation(fields: [slotId], references: [id], onDelete: SetNull)
  amount     Int // Kz
  paidAt     DateTime  @default(now())
  periodEnd  DateTime? // the new "paid through" date this payment covers
  method     String? // cash, transfer, etc.
  note       String?
  createdAt  DateTime  @default(now())
}

/// Money going OUT — you paid a platform. Drives the expense report.
model Expense {
  id        String    @id @default(cuid())
  platform  String // "spotify" | "netflix" | "other" | …
  accountId String?
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  label     String?
  amount    Int // Kz
  paidAt    DateTime  @default(now())
  periodEnd DateTime? // the new "paid through" date this payment covers
  note      String?
  createdAt DateTime  @default(now())
}

/// Audit log of every reminder sent (to customers or to you).
model ReminderLog {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  audience   String // "customer" | "owner"
  channel    String // "sms" | "email"
  to         String?
  subject    String?
  message    String
  status     String // "sent" | "failed" | "dryrun"
  error      String?
  sentAt     DateTime  @default(now())
}
